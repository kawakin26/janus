# Janus バックエンド 環境変数サンプル（フェーズ 1）
# このファイルをコピーして backend/.env を作成し、値を設定する。
# 実際の .env は .gitignore で追跡対象外（本サンプルのみ追跡）。

# Django の秘密鍵。本番では必ず固定のランダム値を設定すること。
# 未設定時は開発起動のため毎回ランダム生成されるが、セッション等は再起動で無効になる。
SECRET_KEY=change-me-in-production

# デバッグモード。既定 false（本番相当）。開発時のみ true にする。
DEBUG=false

# 許可ホスト（カンマ区切り）。未設定かつ DEBUG=true のときは localhost を自動許可。
# 本番では公開ホスト名を明示する（例: janus.example.com）。
ALLOWED_HOSTS=

# データベース接続 URL。未設定なら backend/db.sqlite3 の SQLite を使用。
# PostgreSQL 例: postgres://user:password@localhost:5432/janus
# （PostgreSQL を使う場合は psycopg ドライバの追加インストールが必要）
DATABASE_URL=

# 全体を認証必須にするかの意図フラグ。既定 true。
# （フェーズ 1 のこのタスクでは settings 変数として公開のみ。権限反映は認証実装で行う）
JANUS_REQUIRE_AUTH=true

# アセット（添付ファイル）の保存先。未設定なら backend/media/。
JANUS_MEDIA_ROOT=

# CORS 許可オリジン（カンマ区切り）。未設定なら許可なし（安全側）。
# 開発時のフロント例: http://localhost:5173
JANUS_CORS_ALLOWED_ORIGINS=
